@model IEnumerable<DecorShop.Models.CartItem>

@{
    ViewData["Title"] = "Корзина";
}

<h2 class="mb-4">Ваша корзина</h2>

@if(!Model.Any()) 
{
    <div class="alert alert-info">Ваша корзина пуста. <a asp-controller="Home" asp-action="Catalog">Перейти в каталог</a></div>
} 
else 
{
    <div class="row">
        <div class="col-md-8">
            @foreach(var item in Model)
            {
                <div class="card mb-3 shadow-sm">
                    <div class="row g-0">
                        <div class="col-md-3">
                            @if (!string.IsNullOrEmpty(item.Product?.ImageUrl))
                            {
                                <img src="@item.Product.ImageUrl" class="img-fluid rounded-start" alt="@item.Product.Name" style="height: 100%; object-fit: cover;">
                            }
                            else
                            {
                                <div class="bg-secondary text-white text-center d-flex align-items-center justify-content-center h-100" style="min-height: 100px;">
                                    Нет фото
                                </div>
                            }
                        </div>
                        <div class="col-md-9">
                            <div class="card-body d-flex justify-content-between align-items-center h-100">
                                <div>
                                    <h5 class="card-title">@item.Product?.Name</h5>
                                    <p class="card-text text-muted mb-0">Количество: @item.Quantity шт.</p>
                                </div>
                                <div class="text-end">
                                    <h5 class="mb-3">@(item.Product?.Price * item.Quantity) руб.</h5>
                                    <!-- Ссылка на удаление (пока заглушка) -->
                                    <a asp-action="Remove" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Удалить</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
        
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h4 class="card-title">Итого</h4>
                    <h3 class="mb-4">@Model.Sum(x => x.Product?.Price * x.Quantity) руб.</h3>
                    
                    <!-- ФОРМА ОФОРМЛЕНИЯ ЗАКАЗА -->
                    <form asp-action="Checkout" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-primary btn-lg w-100 shadow">Оформить заказ</button>
                    </form>
                    
                </div>
            </div>
        </div>
    </div>
}