@model IEnumerable<DecorShop.Models.Product>

@{
    ViewData["Title"] = "Управление товарами";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-3">
    <h2>Управление товарами</h2>
    <div>
        <a asp-action="CreateProduct" class="btn btn-success">Добавить товар</a>
        <a asp-action="Reviews" class="btn btn-warning">Модерация отзывов</a>
        <a asp-action="Orders" class="btn btn-info text-white">Управление заказами</a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">В каталоге пока нет товаров.</div>
}
else
{
    <table class="table table-bordered table-striped shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Фото</th>
                <th>Название</th>
                <th>Цена</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach(var item in Model)
            {
                <tr>
                    <td class="align-middle">@item.Id</td>
                    <td class="align-middle">
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" alt="@item.Name" style="width: 50px; height: 50px; object-fit: cover; border-radius: 5px;" />
                        }
                        else
                        {
                            <span class="text-muted" style="font-size: 0.8em;">Нет фото</span>
                        }
                    </td>
                    <td class="align-middle">@item.Name</td>
                    <td class="align-middle">@item.Price руб.</td>
                    <td class="align-middle">
                        <!-- Форма для удаления -->
                        <form asp-action="DeleteProduct" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Вы уверены, что хотите удалить этот товар?');">
                            <button type="submit" class="btn btn-sm btn-danger">Удалить</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}