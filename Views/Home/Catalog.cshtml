@model IEnumerable<DecorShop.Models.Product>

@{
    ViewData["Title"] = "Каталог";
}

<h2 class="mb-4 mt-3">Каталог товаров</h2>

<div class="row">
    @foreach(var item in Model)
    {
        <div class="col-md-3 mb-4">
            <div class="card h-100 shadow-sm">
                
                <!-- БЛОК ВЫВОДА КАРТИНКИ -->
                @if (!string.IsNullOrEmpty(item.ImageUrl))
                {
                    <img src="@item.ImageUrl" class="card-img-top" alt="@item.Name" style="height: 200px; object-fit: cover;">
                }
                else
                {
                    <div class="bg-secondary text-white text-center d-flex align-items-center justify-content-center" style="height: 200px;">
                        Нет фото
                    </div>
                }

                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@item.Name</h5>
                    <p class="card-text text-muted flex-grow-1">@item.Description</p>
                    <h6 class="fw-bold mb-3">@item.Price руб.</h6>
                    
                    <!-- БЛОК КНОПОК -->
                    <div class="mt-auto">
                        <a href="/Cart/Add/@item.Id" class="btn btn-success w-100 mb-2">В корзину</a>
                        <a href="/Review/Create?productId=@item.Id" class="btn btn-outline-secondary w-100">Оставить отзыв</a>
                    </div>

                    <!-- БЛОК ОТЗЫВОВ -->
                    @{
                        var approvedReviews = item.Reviews?.Where(r => r.IsApproved).ToList();
                    }
                    
                    @if (approvedReviews != null && approvedReviews.Any())
                    {
                        <div class="border-top pt-3 mt-3">
                            <small class="text-muted fw-bold">Отзывы:</small>
                            @foreach (var review in approvedReviews)
                            {
                                <div class="bg-light p-2 mt-2 rounded" style="font-size: 0.85em;">
                                    <div class="text-warning mb-1">
                                        @for (int i = 0; i < review.Rating; i++) { <span>★</span> }
                                    </div>
                                    <div>@review.Text</div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>