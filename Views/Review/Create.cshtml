@model DecorShop.Models.Review

<h2>Оставить отзыв на товар: @ViewBag.ProductName</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            <input type="hidden" asp-for="ProductId" />
            
            <div class="mb-3">
                <label asp-for="Text" class="form-label">Ваш отзыв</label>
                <textarea asp-for="Text" class="form-control" rows="4" required></textarea>
                <span asp-validation-for="Text" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Rating" class="form-label">Оценка (1-5)</label>
                <input asp-for="Rating" class="form-control" type="number" min="1" max="5" required />
            </div>

            <button type="submit" class="btn btn-primary">Отправить на модерацию</button>
        </form>
    </div>
</div>